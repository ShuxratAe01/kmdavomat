# Bu faylni .env deb nusxalab, kerakli qiymatlarni o'zgartiring:  cp .env.example .env
# .env fayli git'ga tushmaydi (.gitignore da).

# Server porti
PORT=5175

# Sessiya kaliti.
# Bo'sh qoldirsangiz — birinchi ishga tushganda tasodifiy kalit yaratilib,
# data/secret.key ga saqlanadi. Odatda o'zgartirish shart emas.
# Bir nechta serverda ishlatsangiz, hammasida bir xil qiymat qo'ying (kamida 32 belgi):
# SESSION_SECRET=

# Sessiya necha kun saqlansin (bir marta kirgach shuncha kun eslab qoladi)
SESSION_DAYS=90

# Vaqt mintaqasi — kalendar sanalari shu bo'yicha hisoblanadi
TZ_NAME=Asia/Tashkent

# Video qayerda saqlansin: db (SQLite ichida) yoki disk (uploads/ papkada)
STORAGE=db

# Qaysi kamera ochilsin: user = oldingi (selfi), environment = orqadagi
CAMERA_FACING=user

# --- Yumaloq videoning sifati ---
# Kvadrat tomoni, piksel (480 = kichik fayl, 640 = tiniq, 720 = eng tiniq)
VIDEO_SIZE=640

# Video oqim tezligi, kbit/s (kattalashsa sifat yaxshi, fayl katta)
VIDEO_BITRATE_KBPS=1200

# Ovoz oqim tezligi, kbit/s (nutq uchun 64 yetarli)
AUDIO_BITRATE_KBPS=64

# Sekundiga kadrlar
VIDEO_FPS=30

# Bitta video uchun maksimal davomiylik, soniya
MAX_VIDEO_SECONDS=30

# Bitta video uchun maksimal hajm, MB
MAX_VIDEO_MB=60

# Nechta maktab bo'lsin (faqat birinchi ishga tushganda ro'yxat yaratiladi)
SCHOOL_COUNT=71

# Maktablar o'zlari ro'yxatdan o'ta olsinmi (false = faqat admin yaratadi)
ALLOW_REGISTRATION=true

# Kuniga bir nechta video yuborishga ruxsat berilsinmi
ALLOW_MULTIPLE_PER_DAY=false


# ===== Xavfsizlik =====

# Parolning eng qisqa uzunligi
MIN_PASSWORD_LENGTH=8

# Parol hashlash murakkabligi (12 tavsiya etiladi; kattaroq = xavfsizroq, lekin sekinroq)
BCRYPT_ROUNDS=12

# Nechta xato urinishdan keyin vaqtincha bloklansin
MAX_LOGIN_ATTEMPTS=5

# Blok necha daqiqa davom etsin (keyingi bloklar uzayib boradi)
LOCK_MINUTES=15


# ===== Birinchi admin =====
# Faqat bazada admin bo'lmaganda ishlatiladi.
# ADMIN_PASSWORD ni bo'sh qoldiring — tizim kuchli tasodifiy parol yaratib,
# terminalga BIR MARTA chiqaradi. Birinchi kirishda yangi parol so'raladi.
ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# Ishlab chiqarish rejimi: cookie faqat HTTPS orqali yuriladi + HSTS yoqiladi
# NODE_ENV=production
